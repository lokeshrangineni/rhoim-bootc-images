# =============================================================================
# Stage 1: Builder – UBI9 + CUDA Toolkit + vLLM from source
# =============================================================================
FROM registry.access.redhat.com/ubi9/ubi:latest AS builder

ARG VLLM_VERSION=0.12.0

# Add NVIDIA CUDA repo and install CUDA toolkit + build dependencies
RUN dnf -y install \
      https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm \
    && dnf config-manager --add-repo https://developer.download.nvidia.com/compute/cuda/repos/rhel9/x86_64/cuda-rhel9.repo \
    && dnf -y install \
      cuda-toolkit-12-4 \
      python3.12 \
      python3.12-pip \
      python3.12-devel \
      gcc gcc-c++ \
      cmake ninja-build \
      make git \
    && dnf clean all

ENV CUDA_HOME=/usr/local/cuda-12.4 \
    PATH="/usr/local/cuda-12.4/bin:${PATH}" \
    LD_LIBRARY_PATH="/usr/local/cuda-12.4/lib64:${LD_LIBRARY_PATH}"

# Create venv with Python 3.12
RUN python3.12 -m venv /opt/vllm-venv

ENV PATH="/opt/vllm-venv/bin:${PATH}" \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install PyTorch with CUDA 12.4 support
RUN pip install --no-cache-dir \
      torch torchvision torchaudio \
      --index-url https://download.pytorch.org/whl/cu124

# Copy and run the CUDA build script
COPY scripts/build-vllm-cuda.sh /tmp/build-vllm-cuda.sh
RUN chmod +x /tmp/build-vllm-cuda.sh && \
    /tmp/build-vllm-cuda.sh ${VLLM_VERSION} && \
    rm /tmp/build-vllm-cuda.sh

# Runtime deps
RUN pip install --no-cache-dir \
      fastapi \
      "uvicorn[standard]" \
      transformers \
      sentencepiece \
      huggingface_hub

# =============================================================================
# Stage 2: Runtime – RHEL 9 bootc + CUDA runtime libs
# =============================================================================
FROM registry.redhat.io/rhel9/rhel-bootc:latest

# Install Python 3.12, CUDA runtime libs, and gcc for Triton JIT
RUN dnf -y install \
      python3.12 \
      systemd \
      openssh-server \
      gcc \
    && dnf clean all

# Add NVIDIA CUDA repo and install CUDA runtime libraries
RUN dnf config-manager --add-repo https://developer.download.nvidia.com/compute/cuda/repos/rhel9/x86_64/cuda-rhel9.repo \
    && dnf -y install \
      cuda-cudart-12-4 \
      cuda-nvrtc-12-4 \
      libcublas-12-4 \
      libcufft-12-4 \
      libcurand-12-4 \
      libcusparse-12-4 \
      libcusolver-12-4 \
      libnccl \
      cudnn9-cuda-12 \
    && dnf clean all \
    && ln -sf /usr/local/cuda-12.4 /usr/local/cuda

# Copy venv
COPY --from=builder /opt/vllm-venv /opt/vllm-venv

# Fix venv symlinks for Python 3.12
RUN rm -f /opt/vllm-venv/bin/python3.12 /opt/vllm-venv/bin/python3 /opt/vllm-venv/bin/python && \
    ln -sf /usr/bin/python3.12 /opt/vllm-venv/bin/python3.12 && \
    ln -sf /usr/bin/python3.12 /opt/vllm-venv/bin/python3 && \
    ln -sf /usr/bin/python3.12 /opt/vllm-venv/bin/python

ENV PATH="/opt/vllm-venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    LD_LIBRARY_PATH="/usr/local/cuda/lib64:/usr/local/cuda/compat:${LD_LIBRARY_PATH}"

# Copy config files
COPY etc/ /etc/
COPY vllm/initializer-entrypoint.sh /usr/local/bin/initializer-entrypoint.sh

RUN chmod +x /usr/local/bin/initializer-entrypoint.sh && \
    systemd-sysusers && \
    mkdir -p /opt/rhoim/{bin,models,gateway} /tmp/models && \
    chown -R rhoim:rhoim /opt/rhoim /tmp/models && \
    mkdir -p /sysroot/ostree && \
    ln -sf sysroot/ostree /ostree && \
    systemctl enable rhoim-vllm.service && \
    systemctl enable sshd.service && \
    echo 'root:rhoim-test-2024' | chpasswd && \
    sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config || true

EXPOSE 8000

LABEL org.osbuild.bootc=true \
      bootc=true

RUN bootc container lint || echo "Bootc lint completed with warnings"

ENTRYPOINT []
CMD ["/sbin/init"]

